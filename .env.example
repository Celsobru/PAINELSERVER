# Porta do painel
PORT=3010

# Caminho base publico (Cloudflare Tunnel -> path: /painelserver*)
BASE_PATH=/painelserver

# Segredo do token de login (troque por algo aleatorio). Se vazio, um segredo
# aleatorio temporario e usado (sessoes caem a cada reinicio).
JWT_SECRET=troque-este-segredo-por-um-aleatorio

# Segredo do webhook generico de pagamento (header x-webhook-secret ou ?secret=).
# Sem isso, o webhook generico fica desabilitado (mais seguro).
WEBHOOK_SECRET=

# Login do administrador criado automaticamente no primeiro start.
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatoria e gerada e mostrada no log.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@visionhubweb.com.br
ADMIN_PASSWORD=

# Mercado Pago (opcional - para baixa automatica de pagamentos)
MERCADOPAGO_ACCESS_TOKEN=

# WhatsApp (whatsapp-web.js - sessao com QR Code)
WHATSAPP_ENABLED=true

# Origens permitidas (separadas por virgula) - deixe vazio para mesma origem
ALLOWED_ORIGINS=
